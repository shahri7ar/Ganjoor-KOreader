{"id":28,"nick":"باباطاهر","url":"/babataher","desc":"باباطاهر عریان عارف و سراینده سده پنجم هجری قمری و هم‌روزگار با طغرل شاه سلجوقی است. درباره پیشآمد‌های زندگی و سرگذشت بابا طاهر اطلاعات بسیاری در دست نیست. برخی تذکره‌نویسان وی را هم‌روزگار با عین‌القضات همدانی ( پیرامون سال ۵۲۵ هجری قمری) و برخی وی را هم‌روزگار خواجه نصیر (۶۷۲ هجری قمری) دانسته‌اند. از باباطاهر افزون بر دوبیتیهای پرآوازه او، مجموعه واژگان قصاری نیز به زبان عربی به نام «اشارات» به جای مانده است. از اشعار باباطاهر مجموعهٔ موثقی در دست نیست، از همین رو نمی‌توان از درستی انتساب همه‌ی اشعاری که به او نسبت می‌دهند آگاه بود.","chunks":2,"cats":{"/babataher":{"t":"باباطاهر","c":["/babataher/2beytiha"],"p":[["غزل","ghazal",2],["قصیده","ghaside",2]]},"/babataher/2beytiha":{"t":"دوبیتی‌ها","p":[["دوبیتی شمارهٔ ۱","sh1",1],["دوبیتی شمارهٔ ۲","sh2",1],["دوبیتی شمارهٔ ۳","sh3",1],["دوبیتی شمارهٔ ۴","sh4",1],["دوبیتی شمارهٔ ۵","sh5",1],["دوبیتی شمارهٔ ۶","sh6",1],["دوبیتی شمارهٔ ۷","sh7",1],["دوبیتی شمارهٔ ۸","sh8",1],["دوبیتی شمارهٔ ۹","sh9",1],["دوبیتی شمارهٔ ۱۰","sh10",1],["دوبیتی شمارهٔ ۱۱","sh11",1],["دوبیتی شمارهٔ ۱۲","sh12",1],["دوبیتی شمارهٔ ۱۳","sh13",1],["دوبیتی شمارهٔ ۱۴","sh14",1],["دوبیتی شمارهٔ ۱۵","sh15",1],["دوبیتی شمارهٔ ۱۶","sh16",1],["دوبیتی شمارهٔ ۱۷","sh17",1],["دوبیتی شمارهٔ ۱۸","sh18",1],["دوبیتی شمارهٔ ۱۹","sh19",1],["دوبیتی شمارهٔ ۲۰","sh20",1],["دوبیتی شمارهٔ ۲۱","sh21",1],["دوبیتی شمارهٔ ۲۲","sh22",1],["دوبیتی شمارهٔ ۲۳","sh23",1],["دوبیتی شمارهٔ ۲۴","sh24",1],["دوبیتی شمارهٔ ۲۵","sh25",1],["دوبیتی شمارهٔ ۲۶","sh26",1],["دوبیتی شمارهٔ ۲۷","sh27",1],["دوبیتی شمارهٔ ۲۸","sh28",1],["دوبیتی شمارهٔ ۲۹","sh29",1],["دوبیتی شمارهٔ ۳۰","sh30",1],["دوبیتی شمارهٔ ۳۱","sh31",1],["دوبیتی شمارهٔ ۳۲","sh32",1],["دوبیتی شمارهٔ ۳۳","sh33",1],["دوبیتی شمارهٔ ۳۴","sh34",1],["دوبیتی شمارهٔ ۳۵","sh35",1],["دوبیتی شمارهٔ ۳۶","sh36",1],["دوبیتی شمارهٔ ۳۷","sh37",1],["دوبیتی شمارهٔ ۳۸","sh38",1],["دوبیتی شمارهٔ ۳۹","sh39",1],["دوبیتی شمارهٔ ۴۰","sh40",1],["دوبیتی شمارهٔ ۴۱","sh41",1],["دوبیتی شمارهٔ ۴۲","sh