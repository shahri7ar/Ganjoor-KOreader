{"id":3,"nick":"خیام","url":"/khayyam","desc":"حکیم ابوالفتح عمربن ابراهیم الخیامی مشهور به «خیام» -فیلسوف و ریاضیدان و منجم و شاعر ایرانی- در سال ۴۳۹ هجری قمری در نیشابور زاده شد. وی در ترتیب رصد ملکشاهی و اصلاح تقویم جلالی همکاری داشت. وی اشعاری به زبان پارسی و تازی و کتاب‌هایی نیز به هر دو زبان دارد. از آثار او در ریاضی و جبر و مقابله، رسالهٔ «فی شرح ما اشکل من مصادرات»، کتاب اقلیدس، رسالهٔ «فی الاحتیال لمعرفه مقداری الذهب و الفضه فی جسم مرکب منهما»، و «لوازم الامکنه» را می‌توان نام برد. وی به سال ۵۲۶ هجری قمری درگذشت. رباعیات او شهرت جهانی دارد.","chunks":4,"cats":{"/khayyam":{"t":"خیام","c":["/khayyam/robaee","/khayyam/tarane","/khayyam/nouroozname","/khayyam/mirafzali"]},"/khayyam/robaee":{"t":"رباعیات","p":[["رباعی شمارهٔ ۱","sh1",1],["رباعی شمارهٔ ۲","sh2",1],["رباعی شمارهٔ ۳","sh3",1],["رباعی شمارهٔ ۴","sh4",1],["رباعی شمارهٔ ۵","sh5",1],["رباعی شمارهٔ ۶","sh6",1],["رباعی شمارهٔ ۷","sh7",1],["رباعی شمارهٔ ۸","sh8",1],["رباعی شمارهٔ ۹","sh9",1],["رباعی شمارهٔ ۱۰","sh10",1],["رباعی شمارهٔ ۱۱","sh11",1],["رباعی شمارهٔ ۱۲","sh12",1],["رباعی شمارهٔ ۱۳","sh13",1],["رباعی شمارهٔ ۱۴","sh14",1],["رباعی شمارهٔ ۱۵","sh15",1],["رباعی شمارهٔ ۱۶","sh16",1],["رباعی شمارهٔ ۱۷","sh17",1],["رباعی شمارهٔ ۱۸","sh18",1],["رباعی شمارهٔ ۱۹","sh19",1],["رباعی شمارهٔ ۲۰","sh20",1],["رباعی شمارهٔ ۲۱","sh21",1],["رباعی شمارهٔ ۲۲","sh22",1],["رباعی شمارهٔ ۲۳","sh23",1],["رباعی شمارهٔ ۲۴","sh24",1],["رباعی شمارهٔ ۲۵","sh25",1],["رباعی شمارهٔ ۲۶","sh26",1],["رباعی شمارهٔ ۲۷","sh27",1],["رباعی شمارهٔ ۲۸","sh28",1],["رباعی شمارهٔ ۲۹","sh29",1],["رباعی شمارهٔ ۳۰","sh30",1],["رباعی شمارهٔ ۳۱","sh31",1],["رباعی شمارهٔ ۳۲","sh32",1],["رباعی شمارهٔ ۳۳","sh33",1],["رباعی شمارهٔ ۳۴","sh34",1],["رباعی شمارهٔ ۳۵","sh35",1],["رباعی شمارهٔ ۳۶","sh36",1],["رباعی شمارهٔ ۳۷","sh37",1],["رباعی شمارهٔ ۳۸","sh38",1],["رباعی شمارهٔ ۳۹","sh39",1],["رباعی شمارهٔ ۴۰","sh40",1],["رباعی شمارهٔ ۴۱","sh41",1],["رباعی شمارهٔ ۴۲","sh42",1],["رباعی شمارهٔ ۴۳","sh43",1],["رباعی شمارهٔ ۴۴","sh44",1],["رباعی شمارهٔ ۴۵"