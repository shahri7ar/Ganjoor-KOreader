","sh3",7],["بخش ۴ - حکایت","sh4",7],["بخش ۵ - حکایت","sh5",7],["بخش ۶ - حکایت","sh6",7],["بخش ۷ - حکایت","sh7",7],["بخش ۸ - حکایت","sh8",7],["بخش ۹ - حکایت","sh9",8]]},"/vahshi/nazer-manzoor":{"t":"ناظر و منظور","p":[["سر آغاز","sh1",8],["نظر اعتبار بر صورت عالم گشودن و راه سخن به گام عرفان طی نمودن در سر این معنی که درون از پردهٔ موجودات واجب‌الوجودی هست و برون از حلقهٔ کاینات معبودی که حرکت هر جانداری از قدرت اوست و کثرت تغییر عالم شاهد بر وحدت او","sh2",8],["دست نیاز به درگاه بی‌نیاز گشودن و از حضرت باری التماس رستگاری نمودن","sh3",8],["مثقب خامه را بر گوهر نهادن و رشته‌های گوهر معنی را ترتیب دادن در ایثار تاجداری که گوهر ذاتش باعث دریای آفرینش است و جوهر صفاتش منشاء فیض ارباب بینش است","sh4",8],["طلوع کردن اختر معانی از افق سپهر نکته دانی در تعریف شبی که اخترش طعنه بر نور بدر می‌زد و صحبتش طعنه بر شام قدر","sh5",8],["رو به میدان معانی کردن و تیغ دو زبان برآوردن در مدح شهسواری که از دو انگشت نوک تیغ دو سر دیدهٔ شرک را کور نمود و از بنان ذوالفقار پیکر باب خیبر گشاده","sh6",8],["در منشاء انشاء این نامه غریب‌المعانی و باعث تصنیف این نسخهٔ نادر بیانی","sh7",8],["پایهٔ سریر معانی بر عرش نهادن و گام فکر در عرصهٔ سپهر گشادن در مدح شهسواری که فضای هستی گویی از اقلیم اوست","sh8",8],["حکایت ناقل این مقاله و شکایت قایل این رساله در بی‌وفایی یاران ریایی و دلایل بر فضیلت گوشهٔ تنهایی","sh9",8],["شیر حکمت از پستان خامه گشادن و طفل فسانه را در مهد خیال پرورش دادن در آغاز حکایت عشقبازی و ابتداء روایت نکته سازی","sh10",8],["لوح معنی در دامن حکایت نهادن و زبان به درس نکته گشادن در تعریف مکتبی که لعبت خانهٔ چین از او نشانه‌ایست و حدیث  خلدبرین افسانه‌ای","sh11",8],["بیان خوابی و اظهار اضطرابی که ناظر را از راز پنهان از بی‌صبری خبر داده و داغ ناصبوریش بر جگر نهاده و حکایت مفارقت و شکایت مهاجرت","sh12",8],["بی‌تابی ناظر از شعلهٔ جدایی و اضطراب نمودن از داغ بینوایی و خویشتن را بر مشق جنون داشتن و شرح درون خویش بر چهرهٔ معلم نگاشتن","sh13",8],["رفتن معلم به در خانهٔ دستور و بیان کردن عشق ناظر نسبت به منظور و مقدمهٔ درد فراق و آغاز حکایت اشتیاق","sh14",8],["بیان ظلمت شب دوری و اظهار محنت مهجوری و شرح حال ناظر دور از وصال منظور و صورت احوال او در پایداری","sh15",8],["ناقهٔ خیال در وادی سخن راندن و لعبت نظم را در هودج اندیشه نشاندن در رفتن ناظر از اقلیم وصال و خیمه زدن در سرمنزل رنج و ملال","sh16",8],["یاد نمودن ناظر از بزم آشنایی و ناله کردن از اندوه جدایی و شکایت بخت نامساعد بر زبان آوردن و حکایت طالع نامناسب بیان کردن","sh17",8],["در تعریف محیطی که موجش با قوس قزح برابری می‌کرد و کشتیش به زورق آفتاب سر در نمی‌آورد","sh18",8],["خبر یافتن منظور از رفتن ناظر و برون آمدن از شهر آشفته خاطر و به کاروان مقصود رسیدن و از نامهٔ ناظر شادمان گردیدن","sh19",8],["رفتن آن شهسوار شهب تازیانه و شاهباز فلک آشیانه به جست و جوی آن آهوی سر در بیابان محنت نهاده و آن طایر دور از مقام عزت فتاده","sh20",8],["رسیدن آن گل نودمیدهٔ چمن رعنایی و سرو تازه رسیدهٔ گلشن زیبایی به مرغزاری که پنجهٔ چنارش شاخ بیداد شکستی و آفتاب بلند پایه در  سایه بیدش نشستی","sh21",8],["رسیدن رسولان قیصر به زمین بوس شاه مصر کشور و حرف ناامیدی شنیدن و پا از سر بزم خسروی کشیدن و مقدمهٔ جدال و آغاز قتال","sh22",9],["نامه جنون ناظر در کشتی و به طوق دیوانگی گردن نهادن","sh23",9],["خواب دیدن منظور را و زنجیر پاره ساختن وصیت جنون در بیان مصر انداختن","sh24",9],["رسیدن ناظر به کوهی که سنگ و شیشهٔ سپهر را شکستی و پلنگش در کمینگاه گردون نشستی","sh25",9],["گرمی شعلهٔ آفتاب در عالم فتادن و مرغ آبی از غایت گرما منقار از هم گشادن و رفتن شاهزاده از مصر به سبزه‌زاری که از لطف نسیم او روح مسیحا تازه گشتی و با فیض چشمه‌سارش خضر از آب زندگانی گذشتی","sh26",9],["رفتن شاهزاده منظور به شکار و باز را بر کبک انداختن و شام فراق ناظر را به صبح وصال مبدل ساختن","sh27",9],["آمدن ناظر و منظور به لشگرگاه اقبال و آگاهی شاه جهان‌پناه از صورت احوال و استقبال ایشان کردن و شرایط اعزاز بجای آوردن","sh28",9],["عروس خیال از حجلهٔ اندیشه برون آوردن و او را در نظر ناظران جلوه دادن در تعریف بزمگاه سرور و صفت دامادی منظور","sh29",9],["نشستن شاهزاده بر تخت شهریاری و بلند آوازه گشتن در خطبهٔ کامکاری و در اختصار قصه کوشیدن و لباس تمامی بر شاهد فسانه پوشیدن","sh30",9],["دایرهٔ پرگار سخن را از پرگار خانهٔ دو زبان ساختن و در میدانگاه خاتمهٔ ب